
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Power Zone | الأقسام</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f5f6f8;color:#172033}
header{background:#101827;color:white;padding:20px 5%;display:flex;justify-content:space-between;align-items:center}
.logo{color:#facc15;font-size:24px;font-weight:bold}
header a{color:white;text-decoration:none}
.hero{background:#101827;color:white;text-align:center;padding:40px 15px}
.hero h1{color:#facc15;margin-bottom:12px}
.hero p{color:#ddd}
section{padding:30px 5%}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:18px}
.product{background:white;border-radius:12px;overflow:hidden;box-shadow:0 3px 12px #0001}
.product img{width:100%;height:170px;object-fit:cover}
.info{padding:15px}
.info h3{margin-bottom:12px}
.price{color:#b88600;font-weight:bold;font-size:19px;margin-bottom:12px}
button{width:100%;padding:12px;border:0;border-radius:7px;background:#101827;color:white;cursor:pointer}
button:hover{background:#facc15;color:#111}
.back{display:inline-block;margin-top:20px;background:#facc15;color:#111;padding:12px 20px;border-radius:8px;text-decoration:none;font-weight:bold}
.empty{text-align:center;padding:35px;background:white;border-radius:10px}
footer{background:#101827;color:white;text-align:center;padding:20px;margin-top:40px}
</style>
</head>

<body>

<header>
<div class="logo">⚡ POWER ZONE</div>
<a href="index.html">الرئيسية ←</a>
</header>

<div class="hero">
<h1 id="categoryTitle">منتجات القسم</h1>
<p>اكتشف منتجاتنا واختار اللي يناسبك</p>
<a href="index.html" class="back">العودة للرئيسية</a>
</div>

<section>
<div class="products" id="products"></div>
</section>

<footer>
POWER ZONE © 2026
</footer>

<script>
const allProducts=[
{
name:"بريزة فينوس",
category:"مفاتيح وبرايز",
price:28,
image:"https://placehold.co/500x300?text=Venus+Socket"
},
{
name:"مفتاح فينوس",
category:"مفاتيح وبرايز",
price:28,
image:"https://placehold.co/500x300?text=Venus+Switch"
},
{
name:"شاسيه فينوس",
category:"مفاتيح وبرايز",
price:12,
image:"https://placehold.co/500x300?text=Venus+Chassis"
}
];

const params=new URLSearchParams(window.location.search);
const category=params.get("category");

document.getElementById("categoryTitle").textContent=category||"القسم غير محدد";
document.title="Power Zone | "+(category||"الأقسام");

const filtered=allProducts.filter(p=>p.category===category);
const container=document.getElementById("products");

if(filtered.length===0){
container.innerHTML='<div class="empty">لا توجد منتجات في هذا القسم حالياً.<br>سنضيف المنتجات قريباً ⚡</div>';
}else{
filtered.forEach((p)=>{
container.innerHTML+=`
<div class="product">
<img src="${p.image}" alt="${p.name}">
<div class="info">
<h3>${p.name}</h3>
<div class="price">${p.price} جنيه</div>
<button onclick="addProduct('${p.name}',${p.price})">
أضف إلى السلة +
</button>
</div>
</div>`;
});
}

function addProduct(name,price){
let cart=JSON.parse(localStorage.getItem("powerZoneCart")||"[]");
cart.push({name:name,price:price});
localStorage.setItem("powerZoneCart",JSON.stringify(cart));
alert("تمت إضافة "+name+" إلى السلة");
}
</script>

</body>
</html>
